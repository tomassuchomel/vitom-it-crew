PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-random-string-in-production
CLIENT_URL=http://localhost:5173

# PostgreSQL – povinné. Příklad pro Neon:
#   postgres://user:pass@ep-cool-12345.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
# SSL pro lokální Postgres bez TLS nastav na "false". Default: zapnuto.
# DATABASE_SSL=false

# Volitelné: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Volitelné: AI projektový kouč
# Klíč získáš na https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ────────────────────────────────────────────────────────────────────────────
# AI agent (Claude jako executor úkolů) – feature flag + bezpečnostní limity.
# Když je vypnuté (default), zbytek proměnných může být prázdný.
# ────────────────────────────────────────────────────────────────────────────

# Hlavní vypínač. "true" → endpoint pro spouštění agenta je aktivní.
AI_AGENT_ENABLED=false

# Limit nákladů na jeden task v USD. Po překročení agent zastaví práci.
AI_AGENT_MAX_COST_PER_TASK_USD=2.00

# Celkový denní limit v USD napříč všemi úkoly. Brzda proti runaway nákladům.
AI_AGENT_MAX_COST_PER_DAY_USD=20.00

# Pracovní složka, kam agent klonuje worktree (git checkouts pro jednotlivé tasky).
# Musí existovat a být zapisovatelná. Nechej mimo repo, ať se neklonuje rekurzivně.
AI_AGENT_WORKDIR=/tmp/vitom-ai-agent

# Prefix git branchů, které agent smí vytvářet (a které smí být mergnuty z PR).
# Cokoli mimo tento prefix odmítneme, takže agent nemůže přepsat main/develop.
AI_AGENT_ALLOWED_BRANCHES_PREFIX=claude/

# GitHub Personal Access Token s minimálními právy:
#   – read/write Contents + Pull requests
#   – jen tento jeden repository (Fine-grained token doporučen)
# Slouží pro tvorbu PR. Nikdy NEsdílet a NElogovat.
GITHUB_TOKEN=

# Web Push notifikace (PWA). Vygeneruj jednorázově:
#   node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(k)"
# Public key se posílá klientovi přes GET /api/push/vapid-public-key,
# private zůstává jen v serveru. VAPID_SUBJECT je mailto: kontakt na admina.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.cz

# Email agent C — Microsoft 365 OAuth (Azure App Registration).
# Návod (admin v M365 tenantu):
#   1. portal.azure.com → App registrations → New registration
#   2. Name: VITOM IT Crew Email Agent
#   3. Supported account types: Accounts in this organizational directory only (single tenant)
#   4. Redirect URI: Web → https://it.realitniekosystem.cz/api/email/callback
#   5. Po registraci: zkopíruj Application (client) ID + Directory (tenant) ID
#   6. Certificates & secrets → New client secret → zkopíruj VALUE (ne ID)
#   7. API permissions → Add → Microsoft Graph → Delegated:
#        User.Read, Mail.ReadWrite, Mail.Send, MailboxSettings.Read, offline_access
#      → Grant admin consent
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=https://it.realitniekosystem.cz/api/email/callback

# Šifrovací klíč pro tokeny v DB (AES-256-GCM). 32 bajtů, base64.
# Vygeneruj:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Email notifikace (Microsoft Graph, Client Credentials Flow).
# Server posílá z M365 schránky bez per-user OAuth.
#
# Setup v Azure (jednorázově):
#   1. portal.azure.com → App registrations → tvoje existující app (Email C)
#   2. API permissions → Add a permission → Microsoft Graph
#      → Application permissions → Mail.Send
#   3. Klik "Grant admin consent for [vitom]"
#   4. (volitelně, bezpečnější) PowerShell: New-ApplicationAccessPolicy
#      omezí app, aby posílala JEN z MAIL_M365_MAILBOX
#
# Použité env vars:
#   - MICROSOFT_CLIENT_ID/SECRET/TENANT_ID se sdílí s Email C OAuth
#   - MAIL_M365_MAILBOX je odesílatel (musí existovat v tenantu)
#   - APP_BASE_URL pro deep-linky v emailu
MAIL_M365_MAILBOX=notifikace@vitom.cz
APP_BASE_URL=https://it.realitniekosystem.cz
